# Vorlage für die Einstellungen. Kopieren nach ".env" und anpassen:
#   cp .env.example .env

# Datenbank (PostgreSQL 15 oder neuer)
DATABASE_URL=postgres://tippspiel:passwort@localhost:5432/tippspiel

# Adresse, unter der die App erreichbar ist (ohne / am Ende) und Port
APP_URL=http://localhost:3000
PORT=3000
# Optional: nur auf dieser Netzwerk-Adresse lauschen (127.0.0.1 = nur über den Proxy erreichbar)
HOST=

# Langer Zufallswert für den Formular-Schutz. Pflicht, sobald APP_URL mit https:// beginnt.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Diese E-Mail-Adressen dürfen Turniere, Teams, Spiele und Ergebnisse pflegen (Komma-getrennt)
ADMIN_EMAILS=

# Hierhin gehen Vorschläge für neue Sonderfragen (leer = die Absenderadresse MAIL_FROM)
SUGGESTIONS_TO=

# E-Mail-Versand für die Anmelde-Links:
#   console = Links nur im Server-Protokoll ausgeben (zum Ausprobieren)
#   smtp    = über einen E-Mail-Server, z. B. Gmail mit App-Passwort (keine eigene Domain nötig)
#   brevo   = über Brevo (MAIL_FROM muss dort als Absender bestätigt sein; am besten mit eigener Domain)
#   resend  = über Resend (eigene Domain nötig)
MAIL_MODE=console
MAIL_FROM=
MAIL_FROM_NAME=Kronenrunde
MAIL_API_KEY=

# Nur für MAIL_MODE=smtp. Gmail: Adresse als SMTP_USER, App-Passwort als SMTP_PASSWORD
# (App-Passwort erstellen: https://myaccount.google.com/apppasswords – Bestätigung in zwei Schritten nötig)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional
APP_NAME=Kronenrunde
APP_TIMEZONE=Europe/Berlin
# Hinter einem Proxy (Caddy, nginx, Cloudflare Tunnel) auf 1 setzen
TRUST_PROXY=0
# Datenbank beim Start automatisch aktualisieren (Standard: an)
AUTO_MIGRATE=1

# Offizielle Livestreams (Standard: lolesports)
STREAM_TWITCH_URL=
STREAM_YOUTUBE_URL=

# Vorlage für die Einstellungen. Kopieren nach ".env" und anpassen:
#   cp .env.example .env

# Datenbank (PostgreSQL 15 oder neuer)
DATABASE_URL=postgres://tippspiel:passwort@localhost:5432/tippspiel

# Adresse, unter der die App erreichbar ist (ohne / am Ende) und Port
APP_URL=http://localhost:3000
PORT=3000

# Langer Zufallswert für den Formular-Schutz. Pflicht, sobald APP_URL mit https:// beginnt.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Diese E-Mail-Adressen dürfen Turniere, Teams, Spiele und Ergebnisse pflegen (Komma-getrennt)
ADMIN_EMAILS=

# E-Mail-Versand für die Anmelde-Links:
#   console = Links nur im Server-Protokoll ausgeben (zum Ausprobieren)
#   brevo   = über Brevo (MAIL_FROM muss dort als Absender bestätigt sein)
#   resend  = über Resend (eigene Domain nötig)
MAIL_MODE=console
MAIL_FROM=
MAIL_FROM_NAME=LoL-Tippspiel
MAIL_API_KEY=

# Optional
APP_NAME=LoL-Tippspiel
APP_TIMEZONE=Europe/Berlin
# Hinter einem Proxy (Caddy, nginx, Cloudflare Tunnel) auf 1 setzen
TRUST_PROXY=0
# Datenbank beim Start automatisch aktualisieren (Standard: an)
AUTO_MIGRATE=1

{
  "name": "lol-tippspiel",
  "version": "0.14.0",
  "private": true,
  "description": "Tippspiel-Web-App für League-of-Legends-Turniere",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server/main.ts",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts migrate",
    "db:seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts seed",
    "daten": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts daten",
    "abgleich": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts abgleich",
    "login-link": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts login-link",
    "mail-test": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server/cli.ts mail-test",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "test:db": "bash scripts/test-db.sh",
    "test:app": "bash scripts/test-app.sh",
    "typecheck": "tsc --noEmit"
  }
}
